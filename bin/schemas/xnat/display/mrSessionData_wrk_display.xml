<Displays xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../xdat/display.xsd" schema-element="xnat:mrSessionData" full-description="MR Session" brief-description="MR Session">
	<DisplayField id="WRK_STATUS" header="STATUS" visible="true" searchable="false" data-type="string" xsi:type="SubQueryField">
		<Content type="sql">status</Content>
		<description>Workflow</description>
<!--		<HTML-Link>
			<Property name="ONCLICK" value="return rpt('@Field1','wrk:workflowData','wrk:workflowData.wrk_workflowdata_id');">
				<InsertValue id="Field1" field="wrk_workflowdata_id"/>
			</Property>
		</HTML-Link> -->
		<SubQuery>select distinct on (w.id)  w.id as session_id, w.externalid, w.wrk_workflowdata_id, w.pipeline_name ,  w.status from wrk_workflowdata w where w.pipeline_name='@WHERE' order by w.id,launch_time desc</SubQuery>
		<MappingColumns>
			<MappingColumn schemaField="xnat:mrSessionData.ID" queryField="session_id"/>
		</MappingColumns>
		
	</DisplayField>
</Displays>