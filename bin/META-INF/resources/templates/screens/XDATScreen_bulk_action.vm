#* @vtlvariable name="user" type="org.nrg.xdat.security.XDATUser" *#
#* @vtlvariable name="siteConfig" type="org.nrg.xdat.preferences.SiteConfigPreferences" *#
#* @vtlvariable name="turbineUtils" type="org.nrg.xdat.turbine.utils.TurbineUtils" *#
#* @vtlvariable name="displayManager" type="org.nrg.xdat.display.DisplayManager" *#
#set($SESSION_DISPLAY_NAME_PLURAL = $displayManager.getPluralDisplayNameForImageSession())

<!--BEGIN /screens/XDATScreen_bulk_action.vm -->

<div class="data-table-container" style="width:  889px " id="selectable-table-bulk">
    <div class="data-table-titlerow">
        <h3 class="data-table-title">Session</h3>
        <div class="data-table-actionsrow">
            <span class="textlink-sm data-table-action">
                Bulk Actions:
            </span>
            <button class="btn btn-sm data-table-action disabled">
                Select Container
            </button>
            <button class="btn btn-sm data-table-action disabled" >
                Select Pipeline
            </button>
        </div>
        <span class="clear clearfix"></span>
    </div>

    <div class="data-table-wrapper no-body" style="padding-right: 0">
        <table class="xnat-table clean fixed-header" style="border:none;">
            <thead>
            <tr>
                <th class="toggle-all" style="width: 45px;">
                    <input type="checkbox" class="selectable-select-all" id="toggle-all-sessions" title="Toggle All Sessions" />
                </th>
                <th class="left" style="width: 120px">Session</th>
                <th class="left" style="width: 120px">Modality</th>
                <th class="left" style="width: 200px;">Subject</th>
            </tr>
            </thead>
        </table>
    </div>
    <script type="text/javascript">
        var jsSessionList = [];
    </script>
    <div class="data-table-wrapper no-header" style="/* max-height: 320px; overflow-y: auto */">
        <table class="xnat-table clean selectable" style="border: none;">
            <tbody>

    #set($counter=0)
    #set($_ID="")
    #set($_NAME="")
    #set($_LABEL="")
    #set($_VALUE="")
    #set($_COUNT="")
    #set($_TYPE="")
    #set($_SUBJECT="")
    #set($_PROJECT="")

    <!-- Select Sessions -->
            #if ($sessionSummary.isEmpty())
                <tr valign="top">
                    <td colspan="6"><em>No sessions found in the project</em></td>
                </tr>
            #else
                #foreach($sessionRow in $sessionSummary)
		    #set($_ID = $!turbineUtils.escapeHTML("$!sessionRow.get(0)"))
		    #set($_NAME = $!turbineUtils.escapeHTML("$!sessionRow.get(0)"))
		    #set($_LABEL = $!turbineUtils.escapeHTML("$!sessionRow.get(1)"))
		    #set($_VALUE = $!turbineUtils.escapeHTML("$!sessionRow.get(4):$!sessionRow.get(3):$!sessionRow.get(1):$!sessionRow.get(0)"))
		    #set($_TYPE = $!turbineUtils.escapeHTML("$!sessionRow.get(2)"))
		    #set($_TYPE='xnat:mrSessionData')
		    #set($_SUBJECT = $!turbineUtils.escapeHTML("$!sessionRow.get(3)"))
		    #set($_PROJECT = $!turbineUtils.escapeHTML("$!sessionRow.get(4)"))
                    #set($_URL=$link.setAction('DisplayItemAction').addPathInfo('search_element',$_TYPE).addPathInfo('search_field',"${_TYPE}.ID").addPathInfo('search_value',$_ID).addPathInfo('popup',$popup).addPathInfo('project',$_PROJECT))
                    <script type="text/javascript">
                        jsSessionList.push({ id: '$_ID', modality: '$_TYPE' , url: '$_URL'});
                    </script>
                    <tr valign="top" id="session-$_ID">
                        <td class="session-actions-controls session-selector center" style="width: 45px;">
                            <input type="checkbox" class="selectable-select-one" name="sessionAction" value="$_ID" />
                        </td>
                        <td class="session-${_ID}-id" style="width: 120px;">
                            <span class="inline-actions">
                                <i class="fa fa-list-alt" onclick="displaySessionDetails($_ID,$_URL)" title="View Details"></i>
                            </span>
                            <a href="#!" onclick="displaySessionDetails($_ID,$_URL)">
                                $_LABEL
                            </a>
                        </td>
                        <td class="session-${_ID}-modality" style="width: 200px;">
                            <span class="truncateCell truncate175" title="$!_TYPE">$!_TYPE</span>
                        </td>
                        <td class="session-${_ID}-subject left style="font-weight:bold; width: 125px" >
                            <span class="truncateCell truncateCellNarrow" title="$!_SUBJECT">$!_SUBJECT</span>
                        </td>

                        <td style="position: relative; width: 24px;">
                            <div class="inline-actions-menu-toggle hidden"><i class="fa fa-caret-right"></i></div>
                            <ul class="inline-actions-menu single-scan-actions-menu" style="display:none;"></ul>
                        </td>
                    </tr>
                #end

                <script>
                    var XNAT = getObject(XNAT || {});
                    XNAT.data = getObject(XNAT.data || {});
                    XNAT.data.context = getObject(XNAT.data.context || {});
                    XNAT.data.context.sessions = jsSessionList;
                </script>
            #end
            </tbody>

        </table>
    </div>
</div>



<script>
    (function(){
        /* inline session table functions */
        window.displaySessionDetails = function (sessionId, url) {
        	alert("Came here")
                if (!sessionId) return false;
		alert(url)

		XNAT.ui.dialog.open({
		    title: 'Session ' + sessionId,
		    width: 480,
		    content: '<div class="panel"></div>',
		    beforeShow: function (obj) {
			var container = obj.$modal.find('.panel');
			container.append(url);
		    },
		    isDraggable: true,
		    mask: false,
		    footer: {
			content: 'Click in the header to move this dialog around the page'
		    }
		});
	};

     })();
 
</script>
<script src="$content.getURI("scripts/xnat/plugin/scanTable/selectableTableBehavior.js")"></script>
<link rel="stylesheet" href="$content.getURI("scripts/xnat/plugin/scanTable/scanTable.css")"></link>

<BR/>
<BR/>

<!--END /screens/XDATScreen_bulk_action.vm -->

