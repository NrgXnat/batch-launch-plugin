#* @vtlvariable name="om" type="org.nrg.xdat.om.XnatProjectdata" *#

<li class="yuimenuitem" id="processing-dashboard" style="display:none">
	<a class="yuimenuitemlabel" href="#processingBoardbox">Processing Dashboard</a>
	<div id="#processingBoardbox" class="yuimenu">
		<div class="bd">
			<ul class="first-of-type"></ul>
		</div>
	</div>
</li>

<script type="application/javascript">
	const projectId = "$om.getId()";
	XNAT.xhr.getJSON({
		url: XNAT.url.restUrl('/xapi/access/displays/browseable'),
		success: function (data) {
			if (data.length === 0) {
				return;
			}
			let pdli = $('#processing-dashboard');
			let list = '';
			data = data.sort((a, b) => a.plural < b.plural ? -1 : (a.plural > b.plural ? 1 : 0));
			$.each(data, function(i, element){
				if (!(element.imageSession || element.imageScan) && element.elementName !== 'xnat:subjectData') {
					return;
				}
				let href = XNAT.url.rootUrl('/app/template/XDATScreen_bulk_action.vm/project/' + projectId +
						'/dataType/' + element.elementName);
				list += '<li class="yuimenuitem"><a href="' + href + '" class="yuimenuitemlabel">' + element.plural + '</a></li>';
			});
			pdli.find('ul').append(list);
			pdli.show();
		},
		error: function (e) {
			console.log(e);
		}
	});
</script>