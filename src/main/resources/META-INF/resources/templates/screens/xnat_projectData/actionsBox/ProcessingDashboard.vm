##

#* @vtlvariable name="om" type="org.nrg.xdat.om.XnatProjectdata" *#

#set($xsiTypes = [])
#if($data.getSession().getAttribute("userHelper").canRead("xnat:subjectData/project","$om.getId()"))
	#if($om.getSubjectCount() > 0)
		#set($junk = $xsiTypes.add("xnat:subjectData"))
	#end
#end
#if($data.getSession().getAttribute("userHelper").canRead("xnat:experimentData/project","$om.getId()"))
	#foreach ($xsiType in $om.getExperimentCountByXSIType().keySet())
		#set($junk = $xsiTypes.add($xsiType))
	#end
	#foreach ($xsiType in $om.getScanCountByXSIType().keySet())
		#set($junk = $xsiTypes.add($xsiType))
	#end
#end
#if ($xsiTypes.size() == 1)
	<li class="yuimenuitem" id="processing-dashboard">
		#set ( $batchLaunchHistoryUri = "/app/template/XDATScreen_bulk_action.vm/project/$om.getId()/dataType/$xsiTypes.get(0)" )
		<a href="$content.getURI($batchLaunchHistoryUri)">Processing Dashboard</a>
	</li>
#elseif($xsiTypes.size() > 1)
	<script type="application/javascript">
		const procDashTableId = '#processing-dashboard-dttable';
		$(document).ready(function(){
			let data = [];
			#foreach ($xsiType in $xsiTypes)
				#set($batchLaunchHistoryTitle = "")
				#set($batchLaunchHistoryTitle = $!data.getSession().getAttribute("userHelper").getBrowseableElementDisplay($!xsiType).getSchemaElement().getPluralDescription())
				#if ($!batchLaunchHistoryTitle && $batchLaunchHistoryTitle != "")
					data.push({
						name: '$!batchLaunchHistoryTitle',
						item: spawn('a.truncate', {
							href: '$content.getURI("/app/template/XDATScreen_bulk_action.vm/project/$om.getId()/dataType/$xsiType")',
							title: '$!batchLaunchHistoryTitle',
							style: { width: '100%' }
						}, '$!batchLaunchHistoryTitle')
					});
				#end
			#end
			const menuItem = spawn('li.table-list');
			XNAT.table.dataTable([], {
				container: menuItem,
				sortable: false,
				filter: 'item',
				header: false,
				body: false,
				items: {
					item: 'list-item'
				}
			});
			XNAT.table.dataTable(data, {
				container: menuItem,
				sortable: false,
				header: false,
				items: {
					_name: '~data-name',
					item: 'list-item'
				}
			});
			const datatypeList = spawn('div' + procDashTableId, {
				style: "position: absolute; display:none;"
			}, spawn('ul', {
				classes: 'shadowed dark-shadow'
			}, menuItem));
			$('a#processing-dashboard-link').append(datatypeList.element);
		});
		$(document).on('mouseenter', '#processing-dashboard', function() {
			$('div' + procDashTableId).show();
		});
		$(document).on('mouseleave', '#processing-dashboard, ' + procDashTableId, function() {
			let procTable = $('div' + procDashTableId);
			if (!procTable.is(':hover') && !$('#processing-dashboard').is(':hover')) {
				procTable.hide();
			}
		});
	</script>
	<style>
		#actionsMenu .bd ul #processing-dashboard-dttable {
			z-index: 1;
		}

		#actionsMenu .bd ul #processing-dashboard-dttable ul {
			list-style: none;
			padding: 0;
		}

		#actionsMenu .bd ul #processing-dashboard-dttable tr.filter > td {
			background: #f0f0f0;
			padding: 6px 12px;
		}

		#actionsMenu .bd ul #processing-dashboard-dttable tr.filter > td input {
			padding: 5px 7px;
		}

		#actionsMenu .bd ul #processing-dashboard-dttable ul li a {
			font-weight: bold;
			color: #222;
		}
	</style>
	<li id="processing-dashboard" class="yuimenuitem-hassubmenu yuimenuitem">
		<a id="processing-dashboard-link">Processing Dashboard</a>
	</li>
#end
