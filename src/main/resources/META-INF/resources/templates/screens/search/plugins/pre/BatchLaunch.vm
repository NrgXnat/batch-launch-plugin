#* @vtlvariable name="ed" type="org.nrg.xdat.display.ElementDisplay" *#
<script type="text/javascript">
	if (!XNAT.app.typeBasedListingOptions) {
		XNAT.app.typeBasedListingOptions = {};
	}

	function addProcDashOption(type) {
		if (!XNAT.app.typeBasedListingOptions[type]) {
			XNAT.app.typeBasedListingOptions[type] = [];
		}
		XNAT.app.typeBasedListingOptions[type].push({
			action: 'BulkLaunchAction',
			display: 'Processing Dashboard'
		});
	}

	$(window.available_elements).each(function() {
		if (this.isExperiment || this.isImageScan) {
			addProcDashOption(this.elementName);
		}
	});
	addProcDashOption("xnat:projectData");
	addProcDashOption("xnat:subjectData");
</script>